# Makefile.prj - Project Automation Targets for Perf-Dock

VENV = venv
PYTHON = $(VENV)/bin/python3
PIP = $(VENV)/bin/pip

.PHONY: all setup run test e2e lint format clean help install-system-deps install

all: help

help: ## Show this help message
	@echo "Perf-Dock Development Automation"
	@echo ""
	@echo "Targets:"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2}'

install-system-deps: ## Install Ubuntu system packages (requires sudo)
	@echo "Installing system dependencies via apt..."
	sudo apt-get update
	sudo apt-get install -y \
		python3-gi \
		gir1.2-gtk-3.0 \
		gir1.2-ayatanaappindicator3-0.1 \
		gir1.2-notify-0.7 \
		linux-tools-common \
		linux-tools-generic \
		policykit-1

install: ## Install Perf-Dock to the active python environment (pythonic way)
	@echo "Installing Perf-Dock to the current python environment..."
	pipx install . --system-site-packages

setup: ## Create virtualenv and install dependencies
	@echo "Setting up python virtual environment with system site packages..."
	python3 -m venv --system-site-packages $(VENV)
	$(PIP) install --upgrade pip
	$(PIP) install -e .[dev]
	@echo "Setup complete. Virtual environment ready."

run: ## Run the Perf-Dock tray application
	@echo "Starting Perf-Dock..."
	PYTHONPATH=. $(PYTHON) perf_dock/main.py

test: ## Run unit tests with pytest
	@echo "Running unit tests..."
	PYTHONPATH=. $(PYTHON) -m pytest tests/ --cov=perf_dock --cov-report=term-missing

e2e: ## Boot the real app briefly and verify clean startup/shutdown (skips if no display)
	@echo "Running end-to-end smoke test..."
	PYTHONPATH=. PYTHON_BIN=$(PYTHON) bash scripts/e2e_smoke.sh

lint: ## Run comprehensive static analysis (ruff, radon, vulture, bandit, pylint)
	@echo "=== Running Ruff Linter ==="
	$(PYTHON) -m ruff check perf_dock tests
	@echo "=== Running Ruff Formatter (Check) ==="
	$(PYTHON) -m ruff format --check perf_dock tests
	@echo "=== Running Radon (Complexity Gate) ==="
	$(PYTHON) -m radon cc -s -nb perf_dock
	@echo "=== Running Vulture (Dead Code Detection) ==="
	$(PYTHON) -m vulture perf_dock
	@echo "=== Running Bandit (Security Vulnerabilities) ==="
	$(PYTHON) -m bandit -r perf_dock
	@echo "=== Running Pylint (Duplicate Code Check) ==="
	$(PYTHON) -m pylint --disable=all --enable=duplicate-code perf_dock
	@echo "=== Static Analysis Completed Successfully ==="

format: ## Automatically format all code using Ruff
	$(PYTHON) -m ruff format perf_dock tests
	$(PYTHON) -m ruff check --fix perf_dock tests

clean: ## Clean up build artifacts and caches
	rm -rf .pytest_cache .coverage htmlcov .ruff_cache build dist *.egg-info
	find . -type d -name "__pycache__" -exec rm -rf {} +
